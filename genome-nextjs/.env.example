# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# OpenAI (for Chat & Image Generation)
OPENAI_API_KEY=your_openai_api_key

# Google Gemini (for Ad Generation)
GOOGLE_API_KEY=your_google_gemini_api_key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Foreplay API (for ad discovery - optional)
FOREPLAY_API_KEY=your_foreplay_api_key

# AWS / Amazon Bedrock (Amazon Nova Models)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Amazon Bedrock Model (Nova)
BEDROCK_MODEL_ID=amazon.nova-lite-v1

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
